  options:
  - text: Allouer mes points d'attribut
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: Vous prenez un moment pour repartir vos progres.
      messagePool: []
      itemRewardPool: []
      statPenaltyTypes: 
