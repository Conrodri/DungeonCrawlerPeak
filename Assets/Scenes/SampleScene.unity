    costAmount: 0
  - text: Acheter une Potion de Soin (5 or)
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: 
      messagePool: []
      itemRewardPool: []
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
