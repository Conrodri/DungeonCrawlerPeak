  - text: Le menacer pour qu'il vous cede un objet
    checkStat: 7
    dc: 15
    risk: 2
    onSuccess:
      message: Il tremble et vous tend un objet.
      messagePool: []
      itemRewardPool:
      - shuriken
      - caillou
      - baton
      - bomb
      - gold
      statPenaltyTypes: 
      statPenaltyAmounts: 
