  m_Script: {fileID: 11500000, guid: 80331dfce5fc8c54894e7ea649f67e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteractable
  npcName: Etranger encapuchonne
  greeting: Un etranger vous regarde avec mefiance.
  options:
  - text: Le menacer pour qu'il vous cede un objet
    checkStat: 7
    dc: 15
    risk: 2
    onSuccess:
      message: Il tremble et vous tend un objet.
      messagePool: []
      itemRewardPool: 0100000002000000030000000400000000000000
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
    onFailure:
      message: Il vous frappe, s'enfuit et crache une malediction sur vous.
      messagePool: []
      itemRewardPool: 
      statPenaltyTypes: 0400000007000000
      statPenaltyAmounts: 0200000002000000
      curse: 1
      npcDisappearsForever: 1
  - text: Lui demander ce qu'il fait ici
    checkStat: 3
    dc: 10
    risk: 1
    onSuccess:
      message: 
      messagePool:
      - Je fuis un contrat que je ne pouvais pas honorer.
      - Je cherche un tresor perdu par mon grand-pere dans ces murs.
      - Je me cache d'une guilde qui me veut du mal.
      - J'explore ce donjon depuis plus longtemps que vous ne l'imaginez.
      itemRewardPool: 
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
    onFailure:
      message: Il n'a pas de temps a perdre avec des illettres, et s'en va.
      messagePool: []
      itemRewardPool: 
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 1
  - text: Voir sa marchandise
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: Il vous montre ses articles.
      messagePool: []
      itemRewardPool: 
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
    onFailure:
      message: 
      messagePool: []
      itemRewardPool: 
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
