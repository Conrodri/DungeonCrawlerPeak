  npcName: Le Tavernier
  greeting: Bienvenue, voyageur. Ici, vous ne craignez rien.
  options:
  - text: Se reposer (soigne et sauvegarde la partie)
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: Vous vous reposez un moment. Votre progression est sauvegardee.
      messagePool: []
      itemRewardPool: []
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
      removesCursedItem: 0
      savesGame: 1
    onFailure:
      message: 
      messagePool: []
      itemRewardPool: []
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
      removesCursedItem: 0
      savesGame: 0
    isPurchase: 0
    purchaseItemId: 
    purchasePrice: 0
  - text: Acheter une Potion de Soin (5 or)
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: 
      messagePool: []
      itemRewardPool: []
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
      removesCursedItem: 0
      savesGame: 0
    onFailure:
      message: 
      messagePool: []
      itemRewardPool: []
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
      removesCursedItem: 0
      savesGame: 0
    isPurchase: 1
    purchaseItemId: health_potion
    purchasePrice: 5
  - text: Demander des conseils
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: 
      messagePool:
      - Les tonneaux explosifs ne reagissent qu'au feu ou a une explosion voisine
        - inutile de les frapper.
      - Un objet maudit se colle a votre inventaire. Certains PNJ savent lever une
        malediction.
      - Examinez un objet au sol avant de le ramasser si quelque chose vous semble
        louche.
      - La Force determine quels blocs vous pouvez briser a mains nues - une bombe
        passe outre.
      - Les salles securisees comme celle-ci sont les seules ou vous pouvez sauvegarder.
      itemRewardPool: []
      statPenaltyTypes: 
      statPenaltyAmounts: 
      curse: 0
      npcDisappearsForever: 0
      removesCursedItem: 0
      savesGame: 0
    onFailure:
