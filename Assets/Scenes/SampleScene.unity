  options:
  - text: Se reposer (soigne et sauvegarde la partie)
    checkStat: 0
    dc: 0
    risk: 0
    onSuccess:
      message: Vous vous reposez un moment. Votre progression est sauvegardee.
      messagePool: []
      itemRewardPool: []
